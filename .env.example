# =========================================================
# LKL-Trade 交易端环境变量模板（占位，勿填真值）
# 真实掘金凭据放 .secrets/gm.env（gitignored），此处只列需要哪些。
# 策略端(DB)另存其仓(LKL-Trade 只管本机实单)，经 JSON 交换。
# =========================================================

# ---------- 掘金仿真凭据（broker） ----------
GM_TOKEN=
GM_ACCOUNT_ID=
# 金矿终端本地服务地址（默认即可，不必设）
GM_ENDPOINT=127.0.0.1:7001

# ---------- 两端共享：JSON 交易通道 ----------
# 交换目录：本机写 results.json / holdings.json；策略端写 decisions.json。
# 两端须指向同一（经同步/挂载）目录；默认 ~/trade。
TRADE_DIR=~/trade
# 契约：decisions.json（DB策略->本机）、results.json（本机->DB策略）、holdings.json（真仓快照）
# 幂等键 ref = {for_date}|{code}|{action}；账本 executed.json 防重

# ---------- 运行依赖 ----------
# 金矿终端(Hongshu Goldminer3) 需在 127.0.0.1:7001 运行且已登录账户（原生三方）